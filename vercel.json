{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/course-cron", "schedule": "0 17 * * *" }
  ],
  "functions": {
    "api/blog-share.ts": { "includeFiles": "dist/index.html" }
  },
  "images": {
    "sizes": [640, 1080, 1600],
    "qualities": [75],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      { "protocol": "https", "hostname": "cvouvjnsr5c8g0or.public.blob.vercel-storage.com" }
    ]
  },
  "redirects": [
    { "source": "/services/:id(nlp|hypnotherapy|past-life)", "destination": "/services/subconscious-healing", "permanent": true },
    { "source": "/de/services/:id(nlp|hypnotherapy|past-life)", "destination": "/de/services/subconscious-healing", "permanent": true },
    { "source": "/:page(our-services|sessions|impressum|privacy-policy)", "destination": "/", "permanent": true },
    { "source": "/:page(about-.*)", "destination": "/", "permanent": true },
    { "source": "/de/blog/jenseits-des-korperlichen-ein-tieferes-verstandnis-von-yoga", "destination": "/de/blog/jenseits-des-korperlichen-ein-tieferes-verstandnis-von-yoga-2", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/review-action", "destination": "/api/notify-review?op=action" },
    { "source": "/api/withdraw", "destination": "/api/notify-reiki-request?op=withdraw" },
    { "source": "/api/newsletter-announce", "destination": "/api/newsletter?op=announce" },
    { "source": "/api/course-quote", "destination": "/api/notify-course-booking?op=quote" },
    { "source": "/api/course-checkout", "destination": "/api/notify-course-booking?op=checkout" },
    { "source": "/api/service-checkout", "destination": "/api/notify-course-booking?op=service-checkout" },
    { "source": "/api/payment-request", "destination": "/api/notify-course-booking?op=payment-request" },
    { "source": "/pay/:id", "destination": "/pay" },
    { "source": "/de/pay/:id", "destination": "/de/pay" },
    { "source": "/api/stripe-webhook", "destination": "/api/notify-course-booking?op=webhook" },
    { "source": "/api/course-cron", "destination": "/api/notify-course-booking?op=cron" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog/:slug", "destination": "/api/blog-share?slug=:slug" },
    { "source": "/de/blog/:slug", "destination": "/api/blog-share?slug=:slug&lang=de" }
  ]
}
