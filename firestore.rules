rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Review helper
    function isValidReview(data) {
      return data.keys().hasAll(['name', 'rating', 'content', 'category', 'createdAt', 'lang'])
          && data.keys().size() >= 6
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.rating is number && data.rating >= 1 && data.rating <= 5
          && data.content is string && data.content.size() > 0 && data.content.size() <= 1000
          && data.category in ['Physical Wellness', 'Mental Clarity', 'Spiritual Healing', 'Kids Yoga', 'Dance Therapy', 'Tarot Reading', 'Chair Yoga']
          && data.lang in ['EN', 'DE']
          && data.createdAt is timestamp;
    }

    // The only two accounts that will ever exist for this app, so a plain
    // email allowlist (rather than "any signed-in user") is enough — see
    // api/_lib/blogAuth.ts for the matching allowlist that gates uploading
    // blog media to Vercel Blob.
    function isBlogAdmin() {
      return request.auth != null
          && request.auth.token.email in ['rijuk@niramay.me', 'richak@niramay.me'];
    }

    // Blog helper
    // Length caps are kept in sync with BLOG_FIELD_LIMITS in
    // src/pages/WritePage.tsx, and leave room for German translations, which
    // usually run 20-35% longer than the English original.
    function isValidBlog(data) {
      return data.keys().hasAll(['slug', 'title', 'content', 'createdAt', 'lang', 'published'])
          && data.keys().hasOnly(['slug', 'title', 'excerpt', 'content', 'image', 'audioUrl', 'category', 'author', 'lang', 'createdAt', 'updatedAt', 'published', 'translationOf'])
          && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200 && data.slug.matches('^[a-z0-9-]+$')
          && data.title is string && data.title.size() > 0 && data.title.size() <= 300
          && (!('excerpt' in data) || (data.excerpt is string && data.excerpt.size() <= 1500))
          && data.content is string && data.content.size() > 0 && data.content.size() <= 100000
          && (!('image' in data) || (data.image is string && data.image.size() <= 2000))
          && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2000))
          && (!('category' in data) || data.category is string)
          && (!('author' in data) || data.author is string)
          // Id of the other-language post this one translates (WritePage).
          && (!('translationOf' in data) || (data.translationOf is string && data.translationOf.size() > 0 && data.translationOf.size() <= 100))
          && data.lang in ['EN', 'DE']
          && data.createdAt is timestamp
          && (!('updatedAt' in data) || data.updatedAt is timestamp)
          && data.published is bool;
    }

    // Astrology intake helper — holds birth details + a contact, so it's
    // never client-readable (see match block below); only validated on the
    // way in.
    function isValidAstrologyRequest(data) {
      return data.keys().hasAll(['name', 'placeOfBirth', 'dateOfBirth', 'timeOfBirth', 'contact', 'consentAccepted', 'lang', 'createdAt', 'paymentClaimed'])
          && data.keys().hasOnly(['name', 'placeOfBirth', 'dateOfBirth', 'timeOfBirth', 'contact', 'consentAccepted', 'lang', 'createdAt', 'paymentClaimed',
                                  'service', 'package', 'partnerName', 'partnerPlaceOfBirth', 'partnerDateOfBirth', 'partnerTimeOfBirth'])
          && hasValidServiceFields(data)
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.placeOfBirth is string && data.placeOfBirth.size() > 0 && data.placeOfBirth.size() <= 200
          && data.dateOfBirth is string && data.dateOfBirth.size() > 0 && data.dateOfBirth.size() <= 20
          && data.timeOfBirth is string && data.timeOfBirth.size() > 0 && data.timeOfBirth.size() <= 20
          && data.contact is string && data.contact.size() > 0 && data.contact.size() <= 200
          // Consent must be an explicit, affirmative true on the way in —
          // never inferred from the mere act of submitting the form.
          && data.consentAccepted == true
          && data.lang in ['EN', 'DE']
          && data.createdAt is timestamp
          && data.paymentClaimed == false;
    }

    // Reiki booking/request helper (ReikiIntakeModal in src/App.tsx)
    function isValidReikiRequest(data) {
      return data.keys().hasAll(['package', 'name', 'email', 'whatsapp', 'reason', 'consentAccepted', 'lang', 'createdAt', 'paymentClaimed'])
          && data.keys().size() == 9
          && data['package'] in ['in-person', 'distance-single', 'distance-renewal']
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.size() > 0 && data.email.size() <= 200
          && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && data.whatsapp is string && data.whatsapp.size() > 0 && data.whatsapp.size() <= 40
          && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 2000
          && data.consentAccepted == true
          && data.lang in ['EN', 'DE']
          && data.createdAt is timestamp
          && data.paymentClaimed == false;
    }

    // Online course booking helper (CourseIntakeModal in src/App.tsx)
    // Single-date courses carry exactly these 9 fields; multi-date workshops
    // (COURSES entries with `sessions`) add a 10th, the chosen `session`.
    function isValidCourseBooking(data) {
      return data.keys().hasAll(['course', 'name', 'email', 'whatsapp', 'notes', 'consentAccepted', 'lang', 'createdAt', 'paymentClaimed'])
          && (
            (data.course == 'yoga-stress-immunity-sleep' && data.keys().size() == 9)
            || (data.course == 'yoga-adventure'
                && data.keys().size() == 10
                && data.keys().hasAll(['session'])
                && data.session in ['2026-10-24', '2026-10-29'])
          )
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.size() > 0 && data.email.size() <= 200
          && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && data.whatsapp is string && data.whatsapp.size() > 0 && data.whatsapp.size() <= 40
          && data.notes is string && data.notes.size() <= 2000
          && data.consentAccepted == true
          && data.lang in ['EN', 'DE']
          && data.createdAt is timestamp
          && data.paymentClaimed == false;
    }

    // Plain Vedic Astrology requests carry none of the optional fields.
    // Intuitive Guidance & Soul Counseling requests are tagged with `service`
    // and a `package`; the couple package must also carry the partner's
    // birth details (the individual one must not).
    // (Bracket access below: `service` is a reserved word in the rules language.)
    function hasValidServiceFields(data) {
      return (!data.keys().hasAny(['service', 'package', 'partnerName', 'partnerPlaceOfBirth', 'partnerDateOfBirth', 'partnerTimeOfBirth']))
          || (data['service'] == 'intuitive-guidance'
              && data.keys().hasAll(['package'])
              && ((data['package'] == 'individual'
                   && !data.keys().hasAny(['partnerName', 'partnerPlaceOfBirth', 'partnerDateOfBirth', 'partnerTimeOfBirth']))
                  || (data['package'] == 'couple'
                      && data.keys().hasAll(['partnerName', 'partnerPlaceOfBirth', 'partnerDateOfBirth', 'partnerTimeOfBirth'])
                      && data.partnerName is string && data.partnerName.size() > 0 && data.partnerName.size() <= 100
                      && data.partnerPlaceOfBirth is string && data.partnerPlaceOfBirth.size() > 0 && data.partnerPlaceOfBirth.size() <= 200
                      && data.partnerDateOfBirth is string && data.partnerDateOfBirth.size() > 0 && data.partnerDateOfBirth.size() <= 20
                      && data.partnerTimeOfBirth is string && data.partnerTimeOfBirth.size() > 0 && data.partnerTimeOfBirth.size() <= 20)));
    }

    // Tarot intake helper — same pay-first flow as astrology, but holds the
    // visitor's question instead of birth details.
    function isValidTarotRequest(data) {
      return data.keys().hasAll(['name', 'question', 'contact', 'consentAccepted', 'lang', 'createdAt', 'paymentClaimed'])
          && data.keys().size() <= 7
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.question is string && data.question.size() > 0 && data.question.size() <= 1000
          && data.contact is string && data.contact.size() > 0 && data.contact.size() <= 200
          && data.consentAccepted == true
          && data.lang in ['EN', 'DE']
          && data.createdAt is timestamp
          && data.paymentClaimed == false;
    }

    // User account helper
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt'])
          && data.keys().size() == 3
          && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
          // Must match the signed-in token's own address — a client can't
          // create a profile claiming somebody else's email.
          && data.email == request.auth.token.email
          && data.createdAt is timestamp;
    }

    match /reviews/{reviewId} {
      // Only approved reviews are ever readable. A list query must itself
      // filter on approved == true (as the app does) for Firestore to prove
      // every possible match is allowed — a query without that filter, or a
      // get() on an unapproved doc's ID, is rejected outright rather than
      // silently filtered.
      allow get, list: if resource.data.approved == true;
      // Public visitors may submit a review, but it always lands unapproved —
      // a submission can't set approved:true itself. Nothing becomes visible
      // on the site until an admin clicks Approve in the notification email
      // (api/review-action.ts, which uses the admin SDK) — client-side
      // update/delete stays blocked below.
      allow create: if isValidId(reviewId)
                    && isValidReview(incoming())
                    && (!('approved' in incoming()) || incoming().approved == false);
      allow update, delete: if false;
    }

    match /blogs/{blogId} {
      // A public visitor's query must itself filter on published == true
      // (as the site's public blog pages do) for Firestore to prove every
      // possible match is allowed, same as the reviews collection below.
      // Richa/Riju, signed in, can additionally read their own drafts —
      // request.auth doesn't depend on resource.data, so that clause holds
      // for every document once they're signed in, letting their admin
      // dashboard list everything regardless of published state.
      allow get, list: if resource.data.published == true || isBlogAdmin();
      allow create, update: if isBlogAdmin() && isValidBlog(incoming());
      allow delete: if isBlogAdmin();
    }

    // Comments on a blog post. Every write goes through api/blog-comments.ts
    // (admin SDK, bypasses these rules) so it can be rate limited, spam
    // checked and have isAuthor set from a verified token — never by the
    // client. Visitors can read only visible comments on published posts;
    // like the blogs rule above, a visitor's list query must itself filter on
    // status == "visible". Richa/Riju, signed in, see pending/hidden ones too
    // so they can moderate from the post page.
    match /blogs/{blogId}/comments/{commentId} {
      allow get, list: if isBlogAdmin()
                       || (resource.data.status == 'visible'
                           && get(/databases/$(database)/documents/blogs/$(blogId)).data.published == true);
      allow write: if false;
    }

    // Per-voter like/dislike records — server-only (api/blog-vote.ts). Only
    // the aggregate in blogStats is ever shown.
    match /blogs/{blogId}/votes/{voteId} {
      allow read, write: if false;
    }

    // Public like/dislike totals per post, written only by api/blog-vote.ts.
    match /blogStats/{blogId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /astrologyRequests/{requestId} {
      // Never client-readable — this holds names, birth details and a
      // contact address/number. The admin reads it via the Firebase console
      // or the server-side notify endpoint (which uses the admin SDK and so
      // bypasses these rules entirely).
      allow get, list: if false;
      allow create: if isValidId(requestId) && isValidAstrologyRequest(incoming());
      // The only client-side mutation allowed is the visitor flipping their
      // own "I've paid" flag once, from false to true — nothing else about
      // the submission can be changed after the fact.
      allow update: if existing().paymentClaimed == false
                    && incoming().paymentClaimed == true
                    && incoming().diff(existing()).affectedKeys().hasOnly(['paymentClaimed']);
      allow delete: if false;
    }

    match /reikiRequests/{requestId} {
      // Never client-readable, same as astrologyRequests — names, contact
      // details and health-related notes. Read via the Firebase console or
      // the admin-SDK notify endpoint (api/notify-reiki-request.ts).
      allow get, list: if false;
      allow create: if isValidId(requestId) && isValidReikiRequest(incoming());
      // Only in-person bookings take payment up front; the visitor can flip
      // their own "I've paid" flag once, and nothing else.
      allow update: if existing()['package'] == 'in-person'
                    && existing().paymentClaimed == false
                    && incoming().paymentClaimed == true
                    && incoming().diff(existing()).affectedKeys().hasOnly(['paymentClaimed']);
      allow delete: if false;
    }

    match /courseBookings/{requestId} {
      // Never client-readable, same as reikiRequests. Pay-first: the visitor
      // can flip their own "I've paid" flag once, and nothing else.
      allow get, list: if false;
      allow create: if isValidId(requestId) && isValidCourseBooking(incoming());
      allow update: if existing().paymentClaimed == false
                    && incoming().paymentClaimed == true
                    && incoming().diff(existing()).affectedKeys().hasOnly(['paymentClaimed']);
      allow delete: if false;
    }

    match /tarotRequests/{requestId} {
      // Same access model as astrologyRequests above: never client-readable,
      // create-only, plus the visitor's one-way "I've paid" flag.
      allow get, list: if false;
      allow create: if isValidId(requestId) && isValidTarotRequest(incoming());
      allow update: if existing().paymentClaimed == false
                    && incoming().paymentClaimed == true
                    && incoming().diff(existing()).affectedKeys().hasOnly(['paymentClaimed']);
      allow delete: if false;
    }

    match /users/{userId} {
      // A visitor's own account profile — created on signup, readable only
      // by that same signed-in uid. Nothing server-side needs it yet, so
      // there's no admin/service-account carve-out here.
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == userId
                    && isValidUser(incoming());
      // No edit-profile feature yet — keep it immutable after signup rather
      // than opening a partial update path nothing uses.
      allow update, delete: if false;
    }
  }
}
