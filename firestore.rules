rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Review helper
    function isValidReview(data) {
      return data.keys().hasAll(['name', 'rating', 'content', 'category', 'createdAt', 'lang'])
          && data.keys().size() >= 6
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.rating is number && data.rating >= 1 && data.rating <= 5
          && data.content is string && data.content.size() > 0 && data.content.size() <= 1000
          && data.category in ['Physical Wellness', 'Mental Clarity', 'Spiritual Healing', 'Kids Yoga', 'Dance Therapy', 'Tarot Reading', 'Chair Yoga']
          && data.lang in ['EN', 'DE']
          && data.createdAt is timestamp;
    }

    // Blog helper
    function isValidBlog(data) {
      return data.keys().hasAll(['slug', 'title', 'content', 'createdAt', 'lang'])
          && data.slug is string && data.slug.size() > 0
          && data.title is string && data.title.size() > 0
          && data.content is string && data.content.size() > 0
          && data.lang in ['EN', 'DE']
          && data.createdAt is timestamp;
    }

    match /reviews/{reviewId} {
      // Only approved reviews are ever readable. A list query must itself
      // filter on approved == true (as the app does) for Firestore to prove
      // every possible match is allowed — a query without that filter, or a
      // get() on an unapproved doc's ID, is rejected outright rather than
      // silently filtered.
      allow get, list: if resource.data.approved == true;
      // Public visitors may submit a review, but it always lands unapproved —
      // a submission can't set approved:true itself. Nothing becomes visible
      // on the site until an admin flips `approved` to true directly in the
      // Firebase console (client-side update/delete stays blocked below, so
      // this can't be done from the app).
      allow create: if isValidId(reviewId)
                    && isValidReview(incoming())
                    && (!('approved' in incoming()) || incoming().approved == false);
      allow update, delete: if false;
    }

    match /blogs/{blogId} {
      allow get, list: if true;
      // Blog authoring is admin-only content, not a public form. There's no
      // admin sign-in flow in the app yet, so requiring auth here blocks all
      // writes for now — once an admin login exists, this can be narrowed
      // further (e.g. a specific admin UID or custom claim) instead of any
      // signed-in user.
      allow create, update: if request.auth != null && isValidBlog(incoming());
      allow delete: if false;
    }
  }
}
